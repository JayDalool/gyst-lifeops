# Every variable the server reads. Names only: never put a value in this file.
# Copy to .env and fill in. For any secret, NAME_FILE=/path may be set instead
# of NAME (one trailing newline is trimmed); setting both is an error.
# Check a change before restarting: lifeops config

# Web UI password hash (bcrypt). Empty means nobody can sign in.
GYST_PASSWORD_HASH=
# Emergency only: exactly 1 turns session checks off.
GYST_AUTH_DISABLED=
# Bearer token for /api/health/* sync.
GYST_HEALTH_SYNC_TOKEN=
# IANA application timezone; empty uses the built-in default.
GYST_TIMEZONE=
# Exposes the plain unauthenticated .ics feeds when true (tokenized feeds always work).
ALLOW_PUBLIC_CALENDAR_FEEDS=
# Listen port 1-65535 (default 8080); the -addr flag wins.
PORT=
# SQLite path (default data/lifeops.db); the -db flag wins.
DB_PATH=
# Hevy training sync API key.
HEVY_API_KEY=
# Health Coach provider: anthropic or openai; empty disables it.
HEALTH_AI_PROVIDER=
# Health Coach model name; empty uses the provider default.
HEALTH_AI_MODEL=
# Key used when HEALTH_AI_PROVIDER is anthropic.
ANTHROPIC_API_KEY=
# Key used when HEALTH_AI_PROVIDER is openai.
OPENAI_API_KEY=
# Web push VAPID public key; the three VAPID variables are all set or all empty.
VAPID_PUBLIC_KEY=
# Web push VAPID private key.
VAPID_PRIVATE_KEY=
# Web push contact, for example a mailto: address.
VAPID_SUBSCRIBER=
# GitHub token for link sync; empty sends no Authorization header.
GITHUB_TOKEN=
# Jira account email; set together with JIRA_API_TOKEN or leave both empty.
JIRA_EMAIL=
# Jira API token.
JIRA_API_TOKEN=
# Jira site base URL (https only); links must match its host.
JIRA_BASE_URL=
# Slack bot token for link sync.
SLACK_BOT_TOKEN=
# Full Tailscale MagicDNS hostname Caddy serves; docker-compose.yml requires it.
GYST_TLS_HOSTNAME=
