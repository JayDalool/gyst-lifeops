# Use the full MagicDNS name reported by `tailscale status`.
# Caddy obtains and renews its certificate through the local Tailscale daemon.
https://{$GYST_TLS_HOSTNAME} {
	tls {
		get_certificate tailscale
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy gyst-lifeops:8080
}
